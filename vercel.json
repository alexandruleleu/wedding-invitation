{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/wedding-details", "permanent": true }
  ],
  "rewrites": [
    { "source": "/wedding-details", "destination": "/index.html" }
  ]
}
